Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 8
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: L1_world_CYAN
      Alpha: 0.5
      Topic:
        Value: /lidar1/points_world
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 0; 230; 230
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: L2_world_ORANGE
      Alpha: 0.5
      Topic:
        Value: /lidar2/points_world
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 140; 0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: L1_filtered
      Topic:
        Value: /lidar1/filtered_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 5
      Color Transformer: FlatColor
      Color: 0; 255; 255
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: L2_filtered
      Topic:
        Value: /lidar2/filtered_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 5
      Color Transformer: FlatColor
      Color: 255; 200; 0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Clusters
      Namespaces:
        {}
      Topic:
        Value: /lidar/cluster_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: EstimatedPose
      Color: 0; 255; 0
      Alpha: 1
      Shaft Length: 0.3
      Head Length: 0.15
      Covariance:
        Value: true
        Position:
          Alpha: 0.25
          Color: 0; 255; 0
          Scale: 1
        Orientation:
          Value: false
      Topic:
        Value: /drone/estimated_pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: false
      Name: L1_pose
      Color: 0; 200; 255
      Alpha: 1
      Covariance:
        Value: false
      Topic:
        Value: /drone/lidar1_pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: false
      Name: L2_pose
      Color: 255; 160; 0
      Alpha: 1
      Covariance:
        Value: false
      Topic:
        Value: /drone/lidar2_pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: WaypointEstimates
      Namespaces:
        {}
      Topic:
        Value: /drone/waypoint_estimates
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: L1_raw_sensorframe
      Alpha: 0.15
      Topic:
        Value: /lidar1/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 110; 110; 110
  Global Options:
    Fixed Frame: map
    Background Color: 25; 25; 28
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 2
        Y: 1.4
        Z: 1
      Yaw: 1.5
      Pitch: 1.2
Window Geometry:
  Height: 900
  Width: 1400
